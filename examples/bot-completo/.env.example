# Copie para .env e preencha. Nunca publique o arquivo .env.

# O token do bot, exatamente como o site mostra ao criar o bot
# (com ou sem o prefixo "Bot ").
GOLIVE_TOKEN=Bot cole-seu-token-aqui

# Prefixo dos comandos.
PREFIX=!

# Só mude se for apontar para outra instalação do GoLive.
# GOLIVE_API_URL=https://apigolive.nemtudo.me
# GOLIVE_GATEWAY_URL=wss://apigolive.nemtudo.me/ws
